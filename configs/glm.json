{
  "name": "glm",
  "data_dir": "../data/sim/inputs",
  "model": {
    "type": "openai_compatible",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-5.3-flash",
    "api_key_env": "GLM_API_KEY",
    "temperature": 0.0
  },
  "strategy": {"name": "versioned_state", "state_tools_enabled": true, "inject_prior_state": true},
  "budget": {"max_steps": 12, "max_model_calls": 12, "request_timeout_seconds": 60, "deadline_seconds": 180, "max_retries": 1},
  "cases": ["case_beta", "case_gamma", "case_alpha"]
}
