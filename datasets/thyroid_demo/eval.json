{
  "scorer": "workflow",
  "rules": {
    "initial_state": "initial_imaging",
    "evidence_tags": {
      "ev-us-001": [
        "ultrasound",
        "suspicious_lesion"
      ],
      "ev-ct-001": [
        "contrast_imaging",
        "imaging_confirmed_suspicious"
      ],
      "ev-path-001": [
        "pathology",
        "malignancy_confirmed"
      ]
    },
    "transitions": [
      {
        "from": "initial_imaging",
        "to": "advanced_imaging",
        "when": [
          "suspicious_lesion"
        ],
        "allowed_actions": [
          "order_contrast_imaging",
          "order_mri"
        ]
      },
      {
        "from": "initial_imaging",
        "to": "pathology",
        "when": [
          "suspicious_lesion"
        ],
        "allowed_actions": [
          "order_biopsy",
          "order_fna"
        ]
      },
      {
        "from": "advanced_imaging",
        "to": "pathology",
        "when": [
          "imaging_confirmed_suspicious"
        ],
        "allowed_actions": [
          "order_biopsy",
          "order_fna"
        ]
      },
      {
        "from": "pathology",
        "to": "staging",
        "when": [
          "malignancy_confirmed"
        ],
        "allowed_actions": [
          "complete_staging_workup",
          "order_tnm_staging"
        ]
      },
      {
        "from": "staging",
        "to": "treatment_planning",
        "when": [],
        "allowed_actions": [
          "start_treatment_planning",
          "mdt_review"
        ]
      }
    ]
  }
}