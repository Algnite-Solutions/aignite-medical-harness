# Copy to .env and fill in your own key. .env is gitignored;
# the key is read via the environment and never written to code/logs/run artifacts.
GLM_API_KEY=your-key-here
MEDAI_API_KEY=your-key-here
DASHSCOPE_API_KEY=your-key-here
DEEPSEEK_API_KEY=your-key-here

# Optional MedHEB image retrieval. Use port 18766 when connecting through an SSH tunnel.
MEDHEB_SEARCH_URL=http://127.0.0.1:8766
MEDHEB_SEARCH_KEY=
# Alternatively, point to a protected UTF-8 key file; the environment key takes precedence.
MEDHEB_SEARCH_KEY_FILE=
